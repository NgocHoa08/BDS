# Cấu hình Supabase cho Bảng Xếp Hạng Thời Gian Thật (BDSNH)
# Sao chép file này thành .env (khi chạy máy cá nhân)
# hoặc thêm 2 biến này vào Vercel / Netlify / Cloudflare Pages Environment Variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
